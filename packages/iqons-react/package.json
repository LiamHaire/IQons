{
  "name": "iqons-react",
  "version": "0.1.0",
  "description": "IQons icon library for React — outline, fill and duotone variants",
  "keywords": ["icons", "react", "svg", "iqons", "advanced"],
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "generate": "node ../../scripts/build-react.mjs",
    "build": "npm run generate && tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@types/react": "^19",
    "tsup": "^8",
    "typescript": "^5"
  }
}
